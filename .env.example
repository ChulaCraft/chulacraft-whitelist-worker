SUPABASE_URL=
SUPABASE_SECRET_KEY=
POLL_INTERVAL_MS=8000
# Only needed for the RCON transport. The systemd stdin transport ignores these.
RCON_PASSWORD=
RCON_HOST=127.0.0.1
RCON_PORT=25575
# Only for the stdin transport: the instance's game port, probed before writing.
# MINECRAFT_PORT=25565
# Only for tests, which fake the stdin socket outside root's /run.
# MINECRAFT_RUN_DIR=/tmp/minecraft
# Pin a published build, e.g. sha-47db883. Default: latest.
WHITELIST_WORKER_TAG=latest
